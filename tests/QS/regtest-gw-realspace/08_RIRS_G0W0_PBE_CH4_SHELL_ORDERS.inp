&GLOBAL
  PRINT_LEVEL SILENT
  PROJECT RIRS-G0W0-PBE-CH4-SHELLORD
  RUN_TYPE ENERGY
&END GLOBAL

&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME REGTEST_BASIS
    POTENTIAL_FILE_NAME POTENTIAL
    &MGRID
      CUTOFF 300
      REL_CUTOFF 30
    &END MGRID
    &POISSON
      PERIODIC NONE
      POISSON_SOLVER MULTIPOLE
    &END POISSON
    &QS
      METHOD GAPW
    &END QS
    &SCF
      EPS_SCF 1E-6
      MAX_SCF 100
      SCF_GUESS ATOMIC
      &DIAGONALIZATION ON
        ALGORITHM STANDARD
      &END DIAGONALIZATION
      &MIXING T
        ALPHA 0.4
        METHOD BROYDEN_MIXING
        NBUFFER 8
      &END MIXING
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &PROPERTIES
    &BANDSTRUCTURE
      &GW
        GRID_FILE_SUFFIX _base-rs.ion
        GRID_SELECT 3
        NUM_TIME_FREQ_POINTS 10
        RI_RS
        ! Explicit per-shell orders for kind C (10 shells, shipped orders
        ! 3 3 5 5 5 5 5 5 5 5). This LOWERS shell 3 (l=5 -> l=3, 14 -> 6 pts),
        ! keeps shells 1/2/4, and RAISES shells 5-10 (l=5 -> l=7 or l=9).
        ! Per-shell npts: 6 6 6 14 26 26 26 38 38 38 + 1 center = C 225.
        ! H untouched (83). CH4 total = 225 + 4*83 = 557.
        &RI_RS_GRID_ESCALATION C
          SHELL_ORDERS 3 3 3 5 7 7 7 9 9 9
        &END RI_RS_GRID_ESCALATION
      &END GW
    &END BANDSTRUCTURE
  &END PROPERTIES
  &SUBSYS
    &CELL
      ABC 8 8 8
      PERIODIC NONE
    &END CELL
    &COORD
      C  0.0000  0.0000  0.0000
      H  0.6276  0.6276  0.6276
      H -0.6276 -0.6276  0.6276
      H -0.6276  0.6276 -0.6276
      H  0.6276 -0.6276 -0.6276
    &END COORD
    &KIND H
      BASIS_SET ORB aug-SZV-MOLOPT-ae-mini
      BASIS_SET RI_AUX RI_aug-SZV-MOLOPT-ae_N_RI_010_s_p_d_f_g_h_i_4_2_0_0_0_0_0_error_2.4e-06
      POTENTIAL ALL
    &END KIND
    &KIND C
      BASIS_SET ORB aug-SZV-MOLOPT-ae-mini
      BASIS_SET RI_AUX RI_aug-SZV-MOLOPT-ae-mini_N_RI_022_s_p_d_f_g_h_i_6_2_2_0_0_0_0_error_1.4e-06
      POTENTIAL ALL
    &END KIND
    &TOPOLOGY
      &CENTER_COORDINATES
      &END CENTER_COORDINATES
    &END TOPOLOGY
  &END SUBSYS
&END FORCE_EVAL
